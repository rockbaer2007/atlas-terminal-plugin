{
  "kind": "atlas.plugin.repository",
  "atlas": {
    "type": "plugin-repository",
    "schemaVersion": 1
  },
  "name": "ATLAS Terminal Plugin Repository",
  "version": "1",
  "homepage": "https://github.com/rockbaer2007/atlas-terminal-plugin",
  "installPage": "https://rockbaer2007.github.io/atlas-terminal-plugin/install.html",
  "maintainer": "UGSo Software",
  "plugins": [
    {
      "id": "atlas.plugin.terminal",
      "atlas": {
        "type": "plugin",
        "schemaVersion": 1
      },
      "name": "ATLAS Terminal",
      "nameI18n": {
        "de": "ATLAS Terminal",
        "en": "ATLAS Terminal"
      },
      "version": "0.1.5",
      "description": "Authenticated local terminal with ANSI colors, adjustable font size, optional SSH, Oh My Posh themes and a return link to the ATLAS Hub.",
      "descriptionI18n": {
        "de": "Authentifiziertes lokales Webterminal mit ANSI-Farben, einstellbarer Schriftgröße, optionalem SSH, Oh-My-Posh-Themes und einem Rückweg zum ATLAS Hub.",
        "en": "Authenticated local terminal with ANSI colors, adjustable font size, optional SSH, Oh My Posh themes and a return link to the ATLAS Hub."
      },
      "homepage": "https://github.com/rockbaer2007/atlas-terminal-plugin",
      "installPage": "https://rockbaer2007.github.io/atlas-terminal-plugin/install.html",
      "icon": "./plugins/terminal/icon.svg",
      "entry": "/plugin-assets/terminal/index.html",
      "package": "./plugins/terminal/atlas-plugin-terminal.atlas-plugin.json",
      "manifest": "./plugins/terminal/atlas-plugin.json",
      "capabilities": [
        "atlas.terminal.local-shell",
        "atlas.terminal.ssh",
        "atlas.terminal.ansi-colors",
        "atlas.terminal.font-size",
        "atlas.terminal.oh-my-posh-themes"
      ],
      "compatibility": {
        "atlas": ">=0.2.0-alpha.79",
        "host": "administration-local",
        "homeAssistant": ">=2026.8"
      }
    }
  ]
}
